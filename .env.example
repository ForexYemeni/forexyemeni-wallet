# Firebase Configuration
# Go to Firebase Console > Project Settings > Service Accounts > Generate New Private Key
# Paste the FULL JSON content here (raw JSON or base64-encoded)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project-id",...}

# Email Service (Google Apps Script - FREE)
# Deploy the script as web app and paste the URL here
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# Secret key to authenticate with the Google Apps Script
# IMPORTANT: This must match the EMAIL_SECRET in Google Apps Script Properties
EMAIL_SECRET=change-this-to-a-strong-random-secret

# Admin unlock secret (used to unlock user accounts via API)
ADMIN_UNLOCK_SECRET=change-this-to-a-strong-secret

# Emergency reset secret (used to reset database connection)
# Must be at least 8 characters
EMERGENCY_RESET_SECRET=change-this-to-a-strong-secret

# Recovery default PIN (fallback when DB is unreachable)
# Set this to a 6-digit PIN known only to the admin
RECOVERY_DEFAULT_PIN=000000
